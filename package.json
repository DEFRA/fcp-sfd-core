{
  "name": "fcp-sfd-core",
  "version": "2.6.0",
  "description": "Repo to support local development of Single Front Door Microservices",
  "type": "module",
  "main": "scripts/index.js",
  "bin": {
    "sfd-id-check": "scripts/check-synthetic-ids/index.js"
  },
  "files": [
    "scripts/check-synthetic-ids/"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "add-service": "node scripts/add-service.js",
    "clone": "node scripts/clone.js",
    "pull": "node scripts/pull.js",
    "update": "node scripts/update.js",
    "latest-versions": "node scripts/latest-versions.js",
    "check:synthetic-ids": "node scripts/check-synthetic-ids/index.js --staged",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "test": "node --test 'test/**/*.test.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/fcp-sfd-core.git"
  },
  "author": "Defra",
  "license": "OGL-UK-3.0",
  "bugs": {
    "url": "https://github.com/DEFRA/fcp-sfd-core/issues"
  },
  "homepage": "https://github.com/DEFRA/fcp-sfd-core#readme",
  "devDependencies": {
    "husky": "9.1.7",
    "shelljs": "0.8.5",
    "yaml": "^2.7.0"
  }
}
