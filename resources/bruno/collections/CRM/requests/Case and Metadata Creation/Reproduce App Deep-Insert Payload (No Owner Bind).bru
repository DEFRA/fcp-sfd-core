meta {
  name: Reproduce App Deep-Insert Payload (No Owner Bind)
  type: http
  seq: 4
}

post {
  url: {{CRM_URL}}/incidents
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer
  Content-Type: application/json
  Prefer: return=representation
}

vars:pre-request {
  contactId: 8ab86bcb-b1cd-ea11-a812-000d3ab277b5
  accountId: ca24a053-39cc-ea11-a812-000d3ab9bd1c
  schemeId: 351e9206-3498-ee11-be37-000d3adf3558
  subjectId: 4e1910c7-b0d7-ee11-904d-0022489fd23c
  documentTypeId: fe2785b9-f06e-f111-ab0c-7c1e5235c19d
  correlationId: 00000000-0000-0000-0000-000000000000
  rpaOnlinesubmissionId: a1b2c3d4e5f60718293a
  blobFileId: blob-file-id-123
}

body:json {
  {
    "title": "Document Upload",
    "description": "Document uploaded: example.pdf",
    "caseorigincode": 3,
    "prioritycode": 2,
    "customerid_contact@odata.bind": "/contacts({{contactId}})",
    "rpa_Contact@odata.bind": "/contacts({{contactId}})",
    "rpa_Organisation@odata.bind": "/accounts({{accountId}})",
    "rpa_Scheme@odata.bind": "/rpa_schemes({{schemeId}})",
    "subjectid@odata.bind": "/subjects({{subjectId}})",
    "rpa_isunknowncontact": false,
    "rpa_isunknownorganisation": false,
    "incident_rpa_onlinesubmissions": [
      {
        "subject": "Document Upload - example.pdf",
        "description": "File uploaded: example.pdf\nCorrelation ID: {{correlationId}}",
        "scheduledstart": "2026-08-05T11:00:00Z",
        "scheduledend": "2026-08-05T12:00:00Z",
        "rpa_onlinesubmissiondate": "2026-08-05T11:00:00Z",
        "rpa_onlinesubmissionid": "{{rpaOnlinesubmissionId}}",
        "statecode": 0,
        "statuscode": 1,
        "rpa_onlinesubmission_rpa_activitymetadata": [
          {
            "rpa_name": "example.pdf",
            "rpa_blobfileid": "{{blobFileId}}",
            "rpa_DocumentTypeMetaId@odata.bind": "/rpa_documenttypeses({{documentTypeId}})",
            "rpa_filemimetype": "application/pdf"
          }
        ]
      }
    ]
  }
}

settings {
  encodeUrl: false
  timeout: 0
}

docs {
  Byte-for-byte reproduction of fcp-sfd-crm's pre-PR3 deep-insert payload,
  including the "Correlation ID: <guid>" text embedded in the online
  submission's description field — matching buildOnlineSubmissionActivity in
  src/services/case.js. Missing rpa_Scheme's document-type bind and any
  ownerid@odata.bind — compare against "Reproduce App Deep-Insert Payload
  (With Owner Team Bind)" which adds the latter. Useful as a manual
  before/after baseline for the ownerid/regardingobjectid inheritance check
  (see docs/ADRs/0001-... and plans/duplicate-case-creation-on-timeout-*.md,
  assumption 4, in fcp-sfd-crm).
}
