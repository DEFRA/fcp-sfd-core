meta {
  name: Get Account by SBI
  type: http
  seq: 1
}

get {
  url: {{CRM_URL}}/accounts?$select=accountid,rpa_sbinumber
  body: none
  auth: inherit
}

params:query {
  $select: accountid,rpa_sbinumber
  ~$filter: rpa_sbinumber eq '{{sbi}}'
}

vars:pre-request {
  sbi: 163433225
}

script:post-response {
  const response = res.getBody();
  bru.setEnvVar("ORG_IR", response.value[0].accountid);
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Looks up the account (organisation) record by SBI number and stores its
  accountid as the ORG_IR env var, for use in requests that create or
  reference a case's rpa_Organisation binding. Enable the $filter param and
  set the SBI value before running.
}

example {
  name: Organisation
  
