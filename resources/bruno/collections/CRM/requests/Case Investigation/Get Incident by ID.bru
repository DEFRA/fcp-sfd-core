meta {
  name: Get Incident by ID
  type: http
  seq: 1
}

get {
  url: {{CRM_URL}}/incidents(:caseId)
  body: none
  auth: inherit
}

params:query {
  ~$expand: incident_rpa_onlinesubmissions($select=rpa_onlinesubmissionid)
  ~$select: incidentid,title
}

params:path {
  caseId: {{caseId}}
}

headers {
  Authorization: Bearer ACCESS_TOKEN
  Accept: application/json
  OData-MaxVersion: 4.0
  OData-Version: 4.0
}

settings {
  encodeUrl: false
  timeout: 0
}

docs {
  Plain GET of a case by incidentid. $expand/$select are present but
  disabled (~) — enable as needed. Set {{caseId}} in the environment to the
  case you want to inspect.

  caseId used to be pinned here as a pre-request variable. It was removed
  because a request-level variable silently overrides both the environment
  and a CLI --env-var (see @usebruno/cli src/runner/interpolate-vars.js), so
  the pinned value won every time and this request always fetched the same
  old case no matter what the caller asked for. That made it useless as a
  "does this case exist" check, which is what the FLS1-169 runner needs it
  for: it derives a case id and expects a 404.
}
