    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Unauthenticated liveness check."
      },
      "response": []
    },
    {
      "name": "Initiate upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"redirect\": \"/upload-complete\",\n  \"metadata\": {\n    \"sbi\": 105000000,\n    \"crn\": 1050000000,\n    \"frn\": 1102658375,\n    \"submissionId\": \"1733826312\",\n    \"uosr\": \"105000000_1733826312\",\n    \"type\": \"CS_Agreement_Evidence\",\n    \"reference\": \"user entered reference\",\n    \"service\": \"fcp-sfd-frontend\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/uploader/initiate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "uploader",
            "initiate"
          ]
        },
        "description": "Starts an upload session. The payload accepts only `redirect` and `metadata`; the S3 bucket, S3 path, callback URL, permitted MIME types and maximum file size are server-side config and any of them sent by the client is rejected. Returns uploadId, uploadUrl and statusUrl."
      },
      "response": []
    },
    {
      "name": "Uploader status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/uploader/status/{{uploadId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "uploader",
            "status",
            "{{uploadId}}"
          ]
        },
        "description": "Proxies the CDP Uploader scan status for an upload session. The raw CDP state is mapped to pending, success or failure."
      },
      "response": []
    },
    {
      "name": "Process upload request",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uploadStatus\": \"ready\",\n  \"metadata\": {\n    \"sbi\": 105000000,\n    \"crn\": 1050000000,\n    \"frn\": 1102658375,\n    \"submissionId\": \"1733826312\",\n    \"uosr\": \"105000000_1733826312\",\n    \"type\": \"CS_Agreement_Evidence\",\n    \"reference\": \"user entered reference\",\n    \"service\": \"fcp-sfd-frontend\"\n  },\n  \"form\": {\n    \"file1\": {\n      \"fileId\": \"aa0bd0ce-e254-40b4-84b6-f5acded17fe8\",\n      \"filename\": \"test-file.pdf\",\n      \"contentType\": \"application/pdf\",\n      \"detectedContentType\": \"application/pdf\",\n      \"fileStatus\": \"complete\",\n      \"contentLength\": 102400,\n      \"checksumSha256\": \"bng5jOVC6TxEgwTUlX4DikFtDEYEc8vQTsOP0ZAv21c=\",\n      \"s3Key\": \"scanned/aa0bd0ce-e254-40b4-84b6-f5acded17fe8\",\n      \"s3Bucket\": \"test-bucket\"\n    }\n  },\n  \"numberOfRejectedFiles\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/callback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "callback"
          ]
        },
        "description": "The CDP Uploader callback. Authentication is disabled because the caller is an external service.\n\nThe metadata object accepts only sbi, crn, frn, submissionId, uosr, type, reference and service. Any other field fails validation, and a validation failure is persisted and answered with 201 rather than rejected, so check GET /api/v1/status/{correlationId} if no metadata appears.\n\nA file with fileStatus `complete` must carry s3Key, s3Bucket, checksumSha256 and a contentLength above zero, and must not carry hasError, errorMessage, errorCode or errorParams."
      },
      "response": []
    },
    {
      "name": "Retrieve metadata",
      "request": {
        "method": "GET",
