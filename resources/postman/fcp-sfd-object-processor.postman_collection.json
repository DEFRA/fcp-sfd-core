      "value": "http://localhost:3004",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sbi",
      "value": "105000000",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "9fcaabe5-77ec-44db-8356-3a6e8dc51b13",
      "type": "string"
    },
