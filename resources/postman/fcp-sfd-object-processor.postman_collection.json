        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/status/{{correlationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "status",
            "{{correlationId}}"
          ]
        },
        "description": "Returns the persisted callback validation outcome, and any errors, for a correlationId."
      },
      "response": []
    }
  ]
